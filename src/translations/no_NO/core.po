msgid "<p>Dear {WEB_TITLE} admin,</p>"
msgstr "<p>Kjære {WEB_TITLE} admin,</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Part of your order {ORDER_NUMBER} from {WEB_TITLE} is on its way. The rest follows in another parcel.</p>{SHIPMENT_LINES}{ORDER_TRACKING}<p>{ORDER_LINK}</p>"
