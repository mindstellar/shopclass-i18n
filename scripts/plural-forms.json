{
  "_comment": "The gettext Plural-Forms header per locale, copied verbatim from what Crowdin exports for that language. Crowdin is where translators work and it writes these headers on every sync; its rules are not configurable per project, so this file follows Crowdin rather than the other way round -- a rule that differs, even one that means the same, fails npm run check on the next Crowdin pull request. Where CLDR has a category no whole number reaches (Russian, Polish, Czech and Lithuanian have one for fractions like 1.5), the catalogue still carries that form. Every catalogue inherited nplurals=2; plural=(n != 1) from the template before this existed, which gave Russian no way to say both \"2 объявления\" and \"5 объявлений\". scripts/apply-conventions.mjs writes these into the .po headers and scripts/merge.mjs keeps them through a re-merge.",
  "ar_SY": "nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 && n%100<=99 ? 4 : 5);",
  "ca_ES": "nplurals=2; plural=(n != 1);",
  "cs_CZ": "nplurals=4; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 3;",
  "da_DK": "nplurals=2; plural=(n != 1);",
  "de_DE": "nplurals=2; plural=(n != 1);",
  "el_GR": "nplurals=2; plural=(n != 1);",
  "en_IN": "nplurals=2; plural=(n != 1);",
  "en_US": "nplurals=2; plural=(n != 1);",
  "es_ES": "nplurals=2; plural=(n != 1);",
  "fa_IR": "nplurals=2; plural=(n != 1);",
  "fr_FR": "nplurals=2; plural=(n > 1);",
  "he_HE": "nplurals=3; plural=(n==1 ? 0 : n==2 ? 1 : 2);",
  "hi_IN": "nplurals=2; plural=(n != 1);",
  "hr_HR": "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);",
  "hu_HU": "nplurals=2; plural=(n != 1);",
  "id_ID": "nplurals=1; plural=0;",
  "it_IT": "nplurals=2; plural=(n != 1);",
  "ja_JA": "nplurals=1; plural=0;",
  "lt_LT": "nplurals=4; plural=(n%10==1 && (n%100>19 || n%100<11) ? 0 : (n%10>=2 && n%10<=9) && (n%100>19 || n%100<11) ? 1 : n%1!=0 ? 2: 3);",
  "nl_NL": "nplurals=2; plural=(n != 1);",
  "no_NO": "nplurals=2; plural=(n != 1);",
  "pl_PL": "nplurals=4; plural=(n==1 ? 0 : (n%10>=2 && n%10<=4) && (n%100<12 || n%100>14) ? 1 : n!=1 && (n%10>=0 && n%10<=1) || (n%10>=5 && n%10<=9) || (n%100>=12 && n%100<=14) ? 2 : 3);",
  "pt_BR": "nplurals=2; plural=(n != 1);",
  "pt_PT": "nplurals=2; plural=(n != 1);",
  "ro_RO": "nplurals=3; plural=(n==1 ? 0 : (n==0 || (n%100>0 && n%100<20)) ? 1 : 2);",
  "ru_RU": "nplurals=4; plural=((n%10==1 && n%100!=11) ? 0 : ((n%10 >= 2 && n%10 <=4 && (n%100 < 12 || n%100 > 14)) ? 1 : ((n%10 == 0 || (n%10 >= 5 && n%10 <=9)) || (n%100 >= 11 && n%100 <= 14)) ? 2 : 3));",
  "th_TH": "nplurals=1; plural=0;",
  "tr_TR": "nplurals=2; plural=(n != 1);",
  "uk_UK": "nplurals=4; plural=((n%10==1 && n%100!=11) ? 0 : ((n%10 >= 2 && n%10 <=4 && (n%100 < 12 || n%100 > 14)) ? 1 : ((n%10 == 0 || (n%10 >= 5 && n%10 <=9)) || (n%100 >= 11 && n%100 <= 14)) ? 2 : 3));",
  "vi_VN": "nplurals=1; plural=0;",
  "zh_CN": "nplurals=1; plural=0;",
  "zh_TW": "nplurals=1; plural=0;"
}
