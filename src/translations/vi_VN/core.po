#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Dear {WEB_TITLE} admin,</p>"
msgstr "<p>Gửi {WEB_TITLE} admin,</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Part of your order {ORDER_NUMBER} from {WEB_TITLE} is on its way. The rest follows in another parcel.</p>{SHIPMENT_LINES}{ORDER_TRACKING}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Một phần đơn hàng của bạn {ORDER_NUMBER} từ {WEB_TITLE} đang trên đường đến. Phần còn lại sẽ theo sau trong một kiện hàng khác.</p>{SHIPMENT_LINES}{ORDER_TRACKING}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Thank you for your order from {WEB_TITLE}. We have it and will get it ready once your payment ({PAYMENT_METHOD}) is in.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Cảm ơn bạn đã đặt hàng từ {WEB_TITLE}. Chúng tôi có và sẽ chuẩn bị ngay khi bạn thanh toán ({PAYMENT_METHOD}) đã vào.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER} to your original payment method ({PAYMENT_METHOD}). It can take 3-5 working days to show up.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Chúng tôi đã hoàn tiền {REFUND_AMOUNT} theo trật tự {ORDER_NUMBER} đến phương thức thanh toán gốc của bạn ({PAYMENT_METHOD}). Có thể mất 3-5 ngày làm việc để nhận hàng.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER} to your original payment method ({PAYMENT_METHOD}). It can take 3-5 working days to show up.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Chúng tôi đã hoàn tiền {REFUND_AMOUNT} theo trật tự {ORDER_NUMBER} đến phương thức thanh toán gốc của bạn ({PAYMENT_METHOD}). Có thể mất 3-5 ngày làm việc để nhận hàng.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER}.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Chúng tôi đã hoàn tiền {REFUND_AMOUNT} theo trật tự {ORDER_NUMBER}.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
