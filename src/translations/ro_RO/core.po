msgstr "<p>Salut, {USER_NAME},</p><p>{ITEM_TITLE} se vinde acum pentru {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
