#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Dear {WEB_TITLE} admin,</p>"
msgstr "<p>Dear {WEB_TITLE} admin,</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Part of your order {ORDER_NUMBER} from {WEB_TITLE} is on its way. The rest follows in another parcel.</p>{SHIPMENT_LINES}{ORDER_TRACKING}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Bagian dari pesanan Anda {ORDER_NUMBER} dari {WEB_TITLE} sedang dalam perjalanan. Sisanya mengikuti dalam paket lain.</p>{SHIPMENT_LINES}{ORDER_TRACKING}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Thank you for your order from {WEB_TITLE}. We have it and will get it ready once your payment ({PAYMENT_METHOD}) is in.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Terima kasih atas pesanan Anda dari {WEB_TITLE}. Kami memilikinya dan akan menyiapkannya setelah pembayaran Anda ({PAYMENT_METHOD}) sudah masuk.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER} to your original payment method ({PAYMENT_METHOD}). It can take 3-5 working days to show up.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Kami mengembalikan dana {REFUND_AMOUNT} untuk ketertiban {ORDER_NUMBER} ke metode pembayaran asli Anda ({PAYMENT_METHOD}). Bisa memakan waktu 3-5 hari kerja untuk datang.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER} to your original payment method ({PAYMENT_METHOD}). It can take 3-5 working days to show up.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Kami mengembalikan dana {REFUND_AMOUNT} untuk ketertiban {ORDER_NUMBER} ke metode pembayaran asli Anda ({PAYMENT_METHOD}). Bisa memakan waktu 3-5 hari kerja untuk datang.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER}.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Kami mengembalikan dana {REFUND_AMOUNT} untuk ketertiban {ORDER_NUMBER}.</p><p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER}.</p>{ORDER_LINES}<p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Kami mengembalikan dana {REFUND_AMOUNT} untuk ketertiban {ORDER_NUMBER}.</p>{ORDER_LINES}<p>{CREDIT_NOTE_LINK}</p><p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>You have a new message about {ITEM_TITLE}.</p><p>{MESSAGE_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Anda memiliki pesan baru tentang {ITEM_TITLE}.</p><p>{MESSAGE_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} is on its way.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Pesanan Anda {ORDER_NUMBER} dari {WEB_TITLE} sedang dalam perjalanan.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. If you paid for it, you are not charged: any amount taken is returned to you.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Pesanan Anda {ORDER_NUMBER} dari {WEB_TITLE} dibatalkan. Jika Anda membayar, Anda tidak dikenakan biaya: jumlah yang diambil akan dikembalikan kepada Anda.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. Your listing stays on hold until the fee is paid.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Pesanan Anda {ORDER_NUMBER} dari {WEB_TITLE} dibatalkan. Listing Anda akan tetap ditahan sampai biaya dibayar.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was delivered. We hope you enjoy it.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>Pesanan Anda {ORDER_NUMBER} dari {WEB_TITLE} sudah dikirim. Kami harap Anda menikmatinya.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} is back in stock.</p><p>{ITEM_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>{ITEM_TITLE} Sudah tersedia kembali.</p><p>{ITEM_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} now sells for {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"
msgstr "<p>Hai {USER_NAME},</p><p>{ITEM_TITLE} sekarang dijual dengan harga {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Order {ORDER_NUMBER} came in from {USER_NAME} ({USER_EMAIL}). Payment: {PAYMENT_METHOD}.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Pesanan {ORDER_NUMBER} datang dari {USER_NAME} ({USER_EMAIL}). Pembayaran: {PAYMENT_METHOD}.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

