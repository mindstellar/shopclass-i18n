{
  "_comment": "Per-locale display conventions, following CLDR. new-locale.mjs seeds from this so a new language does not inherit en_US's American date order, which is how de_DE, cs_CZ, da_DK, el_GR and ca_ES all ended up printing m/d/Y. date_format is a PHP date() string; currency_format places {NUMBER} and {CURRENCY}. Language names stay in English rather than each language's own name: the picker is admin-facing, and an endonym list is harder to scan for the English-speaking admin who is choosing.",
  "ar_SY": {
    "short_name": "Arabic",
    "direction": "rtl",
    "date_format": "d/m/Y",
    "currency_format": "{NUMBER} {CURRENCY}"
  },
