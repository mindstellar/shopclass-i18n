#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>We refunded {REFUND_AMOUNT} for order {ORDER_NUMBER} to your original payment method ({PAYMENT_METHOD}). It can take 3-5 working days to show up.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Ciao {USER_NAME},</p><p>Abbiamo rimborsato {REFUND_AMOUNT} per l'ordine {ORDER_NUMBER} al tuo metodo di pagamento originale ({PAYMENT_METHOD}). Ci possono volere 3-5 giorni lavorativi per presentarsi.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>You have a new message about {ITEM_TITLE}.</p><p>{MESSAGE_LINK}</p>"
msgstr ""

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} is on its way.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Ciao {USER_NAME},</p><p>Il tuo ordine {ORDER_NUMBER} da {WEB_TITLE} è in arrivo.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. If you paid for it, you are not charged: any amount taken is returned to you.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Ciao {USER_NAME},</p><p>Il tuo ordine {ORDER_NUMBER} da {WEB_TITLE} è stato annullato. Se avete pagato per esso, non siete addebitati: qualsiasi importo preso viene restituito a voi.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. Your listing stays on hold until the fee is paid.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr ""

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was delivered. We hope you enjoy it.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"
msgstr "<p>Ciao {USER_NAME},</p><p>Il tuo ordine {ORDER_NUMBER} da {WEB_TITLE} è stato consegnato. Ci auguriamo che ti piaca.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} is back in stock.</p><p>{ITEM_LINK}</p>"
msgstr "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} è tornato in magazzino.</p><p>{ITEM_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} now sells for {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"
msgstr "<p>Ciao {USER_NAME},</p><p>{ITEM_TITLE} ora vende per {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Order {ORDER_NUMBER} came in from {USER_NAME} ({USER_EMAIL}). Payment: {PAYMENT_METHOD}.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Order {ORDER_NUMBER} è entrato da {USER_NAME} ({USER_EMAIL}). Pagamento: {PAYMENT_METHOD}.</p>{ORDER_LINES}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

