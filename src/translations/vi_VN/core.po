msgstr "<p>Chào {USER_NAME},</p><p>{ITEM_TITLE} hiện bán với giá {ITEM_PRICE}.</p><p>{ITEM_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
