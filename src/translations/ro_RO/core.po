msgstr "<p>Bună {USER_NAME},</p><p>Comanda dvs. {ORDER_NUMBER} de la {WEB_TITLE} a fost anulată. Dacă aţi plătit pentru aceasta, nu sunteţi taxat: orice sumă luată vă este returnată.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was delivered. We hope you enjoy it.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"
msgstr "<p>Bună {USER_NAME},</p><p>Comanda dvs. {ORDER_NUMBER} din {WEB_TITLE} a fost livrată. Sperăm să vă bucurați de ea.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"

#: oc-includes/osclass/classes/mail/CoreEmails.php
