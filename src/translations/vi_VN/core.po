#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} is on its way.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Đơn hàng của bạn {ORDER_NUMBER} từ {WEB_TITLE} đang trên đường đến.</p>{ORDER_TRACKING}{ORDER_ADDRESS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. If you paid for it, you are not charged: any amount taken is returned to you.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Đơn hàng của bạn {ORDER_NUMBER} từ {WEB_TITLE} đã bị hủy. Nếu bạn đã thanh toán, bạn sẽ không bị tính phí: bất kỳ số tiền nào bị trừ sẽ được hoàn trả cho bạn.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was cancelled. Your listing stays on hold until the fee is paid.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Đơn hàng của bạn {ORDER_NUMBER} từ {WEB_TITLE} đã bị hủy. Danh sách của bạn sẽ bị giữ lại cho đến khi thanh toán phí.</p>{ORDER_LINES}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>Your order {ORDER_NUMBER} from {WEB_TITLE} was delivered. We hope you enjoy it.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>Đơn hàng của bạn {ORDER_NUMBER} từ {WEB_TITLE} đã được giao. Chúng tôi hy vọng bạn sẽ thích nó.</p>{ORDER_PRODUCTS}<p>{ORDER_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
msgid "<p>Hi {USER_NAME},</p><p>{ITEM_TITLE} is back in stock.</p><p>{ITEM_LINK}</p>"
msgstr "<p>Chào {USER_NAME},</p><p>{ITEM_TITLE} đã có hàng trở lại.</p><p>{ITEM_LINK}</p>"

#: oc-includes/classes/core/mail/CoreEmails.php
